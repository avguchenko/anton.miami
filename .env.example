# Copy to .env (git-ignored) for `npm run analyze`.
# PostHog → your avatar → Settings → User → Personal API keys → Create:
#   scopes: Query: Read, Project: Read
POSTHOG_PERSONAL_API_KEY=phx_...
# PostHog → Settings → Project → General → "Project ID" (a number)
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
